{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}
    <div class="mb-3">
        {{ form_label(form.label, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.label, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.label) }}
    </div>
    <div class="mb-3">
        {{ form_label(form.price, null, {'label_attr': {'class': 'form-label'}}) }}
        <div class="input-group">
            {{ form_widget(form.price, {'attr': {'class': 'form-control', 'step': '0.01'}}) }}
            <span class="input-group-text">€</span>
        </div>
        {{ form_errors(form.price) }}
    </div>
    <div class="mb-3">
        {{ form_label(form.stock, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.stock, {'attr': {'class': 'form-control', 'min': '0'}}) }}
        <small class="form-text text-muted">Enter the current stock quantity</small>
        {{ form_errors(form.stock) }}
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-circle"></i> {{ button_label|default('Save') }}
        </button>
        <a href="{{ path('app_admin_product_index') }}" class="btn btn-outline-secondary">Cancel</a>
    </div>
{{ form_end(form) }}
